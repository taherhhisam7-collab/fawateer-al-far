{
  "name": "inventory-jard-app",
  "version": "1.0.0",
  "description": "نظام لائحة جرد المخزون مع صلاحيات المحاسب والموظفين والتقارير",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node server/index.js\" \"vite --host\"",
    "server": "node server/index.js",
    "client": "vite --host",
    "build": "vite build",
    "start": "node server/index.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:migrate": "wrangler d1 migrations apply fawateer-db",
    "cf:migrate:local": "wrangler d1 migrations apply fawateer-db --local",
    "cf:db:create": "wrangler d1 create fawateer-db"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "hono": "^4.7.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  }
}
